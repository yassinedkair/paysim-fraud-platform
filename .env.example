AIRFLOW_UID=50000
FERNET_KEY=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# Identité Microsoft Entra du worker Airflow. Remplir uniquement dans .env.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ADLS_ACCOUNT_NAME=stfrauddetection1234
ADLS_CONTAINER_NAME=fraud-data
