FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    FRAUD_MODEL_DIR=/app/model

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 api

COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir '.[modeling,api]' \
    'scikit-learn==1.9.1' 'lightgbm==4.7.0' 'pandas==3.1.1'

COPY artifacts/lightgbm/lightgbm.joblib artifacts/lightgbm/threshold_margin.json ./model/

USER 10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "fraud_platform.api:app", "--host", "0.0.0.0", "--port", "8000"]
